{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bccHub Launcher",
  "version": "1.0.0",
  "identifier": "vn.bcchub.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/launcher?window=floating",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bccHub Launcher",
        "url": "/launcher?window=floating",
        "width": 660,
        "height": 480,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
