{
  "version": 2,
  "redirects": [
    {
      "source": "/pdf",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pdf/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pdf/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pdf/vi",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pdf/vi/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pdf/vi/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pdf/vi/c/:path*",
      "destination": "/c/:path*",
      "permanent": false
    },
    {
      "source": "/pdf/vi/t/:path*",
      "destination": "/t/:path*",
      "permanent": false
    },
    {
      "source": "/pdf/c/:path*",
      "destination": "/c/:path*",
      "permanent": false
    },
    {
      "source": "/pdf/t/:path*",
      "destination": "/t/:path*",
      "permanent": false
    },
    {
      "source": "/pdf/:lang(vi|en)?/:id(merge-pdf|split-pdf|extract-pages|alternate-merge|duplex-collate|overlay-pdf|pdf-to-zip|pdf-multi-tool|organize-pdf|delete-pages|add-blank-page|remove-blank-pages|reverse-pages|rotate-pdf|rotate-custom|divide-pages|combine-single-page|crop-pdf|n-up-pdf|pdf-booklet|posterize-pdf|fix-page-size|page-dimensions|compare-pdfs|add-attachments|extract-attachments|edit-attachments|pdf-layers|edit-pdf|edit-pdf-text|sign-pdf|add-watermark|add-stamps|remove-annotations|page-numbers|add-page-labels|bates-numbering|header-footer|bookmark|table-of-contents|invert-colors|adjust-colors|background-color|text-color|scanner-effect|pdf-to-greyscale|form-filler|form-creator|flatten-pdf|view-metadata|edit-metadata|remove-metadata|image-to-pdf|jpg-to-pdf|png-to-pdf|webp-to-pdf|svg-to-pdf|bmp-to-pdf|heic-to-pdf|tiff-to-pdf|cbz-to-pdf|txt-to-pdf|markdown-to-pdf|csv-to-pdf|json-to-pdf|xml-to-pdf|rtf-to-pdf|email-to-pdf|epub-to-pdf|fb2-to-pdf|pdf-to-jpg|pdf-to-png|pdf-to-webp|pdf-to-bmp|pdf-to-tiff|pdf-to-svg|pdf-to-cbz|extract-images|pdf-to-text|pdf-to-markdown|pdf-to-json|pdf-to-csv|extract-tables|prepare-pdf-for-ai|compress-pdf|word-to-pdf|excel-to-pdf|powerpoint-to-pdf|odt-to-pdf|ods-to-pdf|odp-to-pdf|odg-to-pdf|pdf-to-word|pdf-to-excel|protect-pdf|unlock-pdf|remove-restrictions|change-permissions|sanitize-pdf|repair-pdf|linearize-pdf|rasterize-pdf|pdf-to-pdfa|deskew-pdf|font-to-outline|ocr-pdf|digital-sign-pdf|validate-signature-pdf|timestamp-pdf)\\.html",
      "destination": "/t/:id",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/launcher",
      "destination": "/index.html"
    },
    {
      "source": "/c/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/t/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
