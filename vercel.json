{
  "version": 2,
  "redirects": [
    { "source": "/pdf", "destination": "/", "permanent": false },
    { "source": "/pdf/", "destination": "/", "permanent": false },
    { "source": "/pdf/index.html", "destination": "/", "permanent": false },
    { "source": "/pdf/vi", "destination": "/", "permanent": false },
    { "source": "/pdf/vi/", "destination": "/", "permanent": false },
    { "source": "/pdf/vi/index.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/launcher", "destination": "/index.html" },
    { "source": "/c/(.*)", "destination": "/index.html" },
    { "source": "/t/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
